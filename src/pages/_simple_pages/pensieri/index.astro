---
import Layout from '../../../layouts/Layout.astro';
import SimpleNav from '../../../components/SimpleNav.astro';
import '../../../styles/simple.css';
import { getCollection } from 'astro:content';

const entries = (await getCollection('Pensieri')).sort(
  (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0)
);
---
<Layout title="Thoughts — Klein">
  <main class="s-main">
    <SimpleNav />

    <header>
      <h1 class="s-page-title">Thoughts</h1>
      <p class="s-lede">Scattered thoughts, written as they come.</p>
    </header>

    <hr>

    {entries.length === 0 ? (
      <p class="s-empty">No entries yet.</p>
    ) : (
      <ul class="s-list">
        {entries.map((entry) => (
          <li>
            <a href={`/simple/pensieri/${entry.slug}`}>
              {entry.data.date && (
                <time datetime={entry.data.date.toISOString()}>
                  {entry.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
                </time>
              )}
              <span class="s-list-text">
                <h2>{entry.data.title}</h2>
                <p>{entry.data.summary}</p>
              </span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </main>
</Layout>
